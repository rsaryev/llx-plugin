{
  "events": [
    {
      "group": "Tools",
      "events": [
        "tool.call",
        "tool.check",
        "tool.describe"
      ]
    },
    {
      "group": "Prompts and what Claude reads",
      "events": [
        "prompt.submit",
        "prompt.fill",
        "prompt.suggest",
        "prompt.edit",
        "prompt.autocomplete",
        "prompt.compose",
        "prompt.section",
        "prompt.context",
        "prompt.attachment",
        "prompt.mention",
        "skill.prompt",
        "attribution.text"
      ]
    },
    {
      "group": "Commands and configuration",
      "events": [
        "command.run",
        "command.describe",
        "config.set",
        "config.describe",
        "settings.read"
      ]
    },
    {
      "group": "Turns",
      "events": [
        "turn.start",
        "turn.step",
        "turn.complete"
      ]
    },
    {
      "group": "Session",
      "events": [
        "session.start",
        "session.end",
        "session.compact",
        "session.receive",
        "session.send",
        "session.append",
        "session.attach",
        "session.detach",
        "session.measure"
      ]
    },
    {
      "group": "Subagents",
      "events": [
        "agent.offer",
        "agent.spawn"
      ]
    },
    {
      "group": "Interface",
      "events": [
        "ui.render",
        "ui.resolve",
        "ui.press",
        "ui.input",
        "ui.select",
        "ui.focus",
        "ui.scroll",
        "ui.close",
        "ui.message",
        "ui.fault"
      ]
    },
    {
      "group": "Other mods",
      "events": [
        "plugin.register",
        "engine.create"
      ]
    },
    {
      "group": "Telemetry",
      "events": [
        "telemetry.log",
        "telemetry.mark"
      ]
    }
  ],
