  "limits": [
    {
      "limit": "A hook's own execution time for one event, not counting time inside `next` or a mods API call other than `$.clock.sleep`",
      "value": "10 seconds, or 50 milliseconds for a `prompt.edit` hook"
    },
    {
      "limit": "A `.catch` handler's execution time",
      "value": "1 second"
    },
    {
      "limit": "All `session.end` hooks together",
      "value": "As long as the [SessionEnd hook budget](https://code.claude.com/docs/en/hooks.md#sessionend-input), 1.5 seconds unless you change it, counted from when your settings `SessionEnd` hooks finish"
    },
    {
      "limit": "`$.process.run` timeout",
      "value": "30 seconds by default, 10 minutes at most"
    },
    {
      "limit": "`$.process.run` `stdout` and `stderr`",
      "value": "4 MiB each. `isStdoutTruncated` or `isStderrTruncated` is `true` when one was cut."
    },
    {
      "limit": "`$.model.complete` `maxTokens`",
      "value": "1024 by default, up to 64,000 or the model's output limit"
    },
    {
      "limit": "`$.fs.read` and `$.fs.write`",
      "value": "4 MiB for one file"
    },
    {
      "limit": "A `$.http.fetch` request body",
      "value": "4 MiB, counted in characters. A call with a larger body rejects."
    },
    {
      "limit": "A `$.http.fetch` response body",
      "value": "4 MiB. `text` holds the first 4 MiB and the rest isn't read. When the `Content-Length` header declares more, the call rejects instead, with a reason that ends `is over the 4194304-byte limit`, except when the last request after any redirects uses the `HEAD` method. The `HEAD` exemption requires Claude Code v2.1.296 or later."
    },
    {
      "limit": "One `$.http.fetch` call, redirects and body included",
      "value": "30 seconds"
    },
    {
      "limit": "Redirects one `$.http.fetch` call follows",
      "value": "5"
    },
    {
      "limit": "A hook's `drop` reason or `config.set` `deny` reason",
      "value": "4,096 characters. The end of a longer reason is cut, and the drop or deny still applies. The cut requires Claude Code v2.1.292 or later, and on earlier versions the hook [fails](https://code.claude.com/docs/en/plugins/mods/events.md#handle-a-hook-that-fails) instead."
    },
    {
      "limit": "Text in one tree",
      "value": "The first 100,000 characters are drawn"
    },
    {
      "limit": "A `Code`'s `language` or `path`, a `Select` option's `value`, or a `Client`'s `module`",
      "value": "10,000 characters. If one is longer, the `ui.render` hook that returned it [fails](https://code.claude.com/docs/en/plugins/mods/events.md#handle-a-hook-that-fails)."
    },
    {
      "limit": "A `Link`'s `href`",
      "value": "2,048 characters. If it's longer, the `ui.render` hook that returned it [fails](https://code.claude.com/docs/en/plugins/mods/events.md#handle-a-hook-that-fails)."
    },
    {
      "limit": "Nesting depth of one tree",
      "value": "32 levels below the root element"
    },
    {
      "limit": "Elements and text children in one tree",
      "value": "20,000"
    },
    {
      "limit": "`Raster` cells in one tree, each `Raster`'s `columns` times its `rows`",
      "value": "262,144"
    },
    {
      "limit": "PNG or RGBA bytes of all the `Image`s in one tree",
      "value": "2 MiB"
    },
    {
      "limit": "`$.store`",
      "value": "4 MiB of JSON in total"
    },
    {
      "limit": "`$.session.messages()`",
      "value": "The newest 4,096 entries"
    },
    {
      "limit": "`$.ui.invalidate('ui.render')` redraws",
      "value": "Throttled to 10 a second, or 30 in the terminal for the visible pane, the expanded band, and the hint line under the prompt. Calls that come sooner are coalesced."
    },
    {
      "limit": "`$.ui.toast`",
      "value": "Shown for 4 seconds unless you pass `{ timeoutMs }`. In the [classic renderer](https://code.claude.com/docs/en/fullscreen.md#enable-fullscreen-rendering), a mod's newer toast can [take the place of its older one](https://code.claude.com/docs/en/plugins/mods/troubleshoot.md#a-toast-doesn’t-appear) that's showing or waiting to show."
    },
    {
      "limit": "A pane opened without the user asking",
      "value": "Placed from 144 terminal columns, 110 after they've opened it once"
    },
    {
      "limit": "Nesting depth of a mods API call's arguments",
      "value": "28,000 levels. Past that, the call rejects with a message ending `nesting deeper than 28000 levels is not supported`. Requires Claude Code v2.1.299 or later."
    },
    {
      "limit": "Nesting depth of a changed event passed to `next`, outside [async generator hooks](#events) such as one on `turn.step`",
      "value": "28,000 levels. Past that, `next` rejects with a message ending `nesting deeper than 28000 levels is not supported`. Requires Claude Code v2.1.299 or later."
    },
    {
      "limit": "Nesting depth of a hook's return value, outside `ui.render`, `ui.resolve`, and async generator hooks",
      "value": "28,000 levels. Past that, the hook's result is refused, and [the notice that reports it](https://code.claude.com/docs/en/plugins/mods/troubleshoot.md#find-out-why-a-mod-does-nothing) includes `nesting deeper than 28000 levels is not supported`. Requires Claude Code v2.1.299 or later."
    },
    {
      "limit": "Scopes, such as functions, blocks, and loops, nested inside one another in one file of a hooks module",
      "value": "2,000"
    },
    {
      "limit": "Command, tool, subagent type, and pane names",
      "value": "Letters, digits, `_`, and `-`, up to 64 characters"
    },
    {
      "limit": "One `claude plugin test` test",
      "value": "5 seconds unless the test sets `timeoutMs`"
    }
  ],
