{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/dist/**",
    ".cache/**",
    "bun.lock",
    "CHANGELOG.md",
    "docs/**",
    "spec/**",
    "tests/fixtures/model-content/**",
    "tests/fixtures/runtime/**"
  ]
}
