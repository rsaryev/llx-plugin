{
  "name": "@rsaryev/claude-plugin-kit",
  "version": "0.0.0",
  "description": "Add Claude Code plugin support to any agent: load plugins and run their skills, commands, agents and hooks through ports your host implements.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsaryev/claude-plugin-kit.git"
  },
  "files": [
    "dist",
    "src",
    "!**/*.test.*"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "bun": "./src/testing/index.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "lint": "oxlint --type-aware && oxlint -c config/lint/quality.json src",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "docs:pull": "bun scripts/docs/pull.ts",
    "spec:extract": "bun scripts/spec/extract.ts",
    "compat": "bun scripts/compat/report.ts",
    "corpus:fetch": "bun scripts/corpus/fetch.ts",
    "bench": "bun scripts/bench/run.ts",
    "mutation": "bun scripts/mutation/run.ts",
    "corpus": "bun scripts/corpus/run.ts",
    "check": "bun run check:static && bun run compat --check",
    "check:static": "bun run format:check && bun run lint && bun run check:size && bun run check:layers && bun run check:test-layout && bun run check:tests && bun run check:spec && bun run check:docs && bun run check:deadcode && bun run typecheck",
    "check:size": "bun scripts/check-file-size.ts",
    "check:layers": "bun scripts/check-layers.ts",
    "check:test-layout": "bun scripts/check-test-layout.ts",
    "check:tests": "bun scripts/check-focused-tests.ts",
    "check:spec": "bun scripts/spec/check.ts",
    "check:docs": "bun scripts/check-docs.ts",
    "check:deadcode": "knip --no-config-hints",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "ignore": "7.0.14",
    "semver": "7.8.6",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@anthropic-ai/sdk": "1.6.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@stryker-mutator/core": "10.1.1",
    "@types/bun": "1.4.4",
    "@types/semver": "7.8.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "knip": "6.44.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.319 <0.4.0"
  },
  "packageManager": "bun@1.4.4"
}
